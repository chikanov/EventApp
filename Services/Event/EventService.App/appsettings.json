{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pagination": {
    "PageSize": 10
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventapi;Username=postgres;Password=postgres"
  },
  "TokenValidationParameters": {
    "ValidIssuer": "EventService",
    "ValidAudience": "BackendEventServiceApi",
    "TokenLifeTimeMinutes": 60,
    "SecretKey": "Super_Secret_Key_32_Characters_Long12345"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "event-processing"
  },
  "Redis": {
    "Redis__ConnectionString": "localhost:6379"
  },
  "ServiceName": "EventService",
  "OtlpExporterEndpoint": "http://localhost:4318/v1/traces",
  "Otlp": {
    "Endpoint": "http://localhost:4318/v1/traces"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
